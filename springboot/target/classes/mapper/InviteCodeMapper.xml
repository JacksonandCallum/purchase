<mapper namespace="com.example.mapper.InvitationCodeMapper">

    <sql id="Base_Column_List">
        id,code,generator,status,create_time,expire_time,use_count,used_count,user_type,bind_email
    </sql>

    <select id="selectAll" resultType="com.example.entity.InvitationCode">
        select
        <include refid="Base_Column_List" />
        from invitation_code
        <where>
            <if test="id != null"> and id= #{id}</if>
            <if test="code != null"> and code = #{code}</if>
            <if test="generator != null"> and generator = #{generator}</if>
            <if test="status != null"> and status = #{status}</if>
            <if test="createTime != null"> and create_time = #{createTime}</if>
            <if test="expireTime != null"> and expire_time = #{expireTime}</if>
            <if test="useCount != null"> and use_count = #{useCount}</if>
            <if test="usedCount != null"> and used_count = #{usedCount}</if>
            <if test="userType != null"> and user_type = #{userType}</if>
            <if test="bindEmail != null"> and bind_email like concat('%', #{bindEmail}, '%')</if>
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="selectById" resultType="com.example.entity.InvitationCode">
        select
        <include refid="Base_Column_List" />
        from invitation_code
        where id = #{id}
    </select>

    <delete id="deleteById">
        delete from invitation_code
        where  id = #{id}
    </delete>

